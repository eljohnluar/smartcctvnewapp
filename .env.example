# Copy to .env (local dev) or set in Vercel → Project → Settings → Environment Variables
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend API (Railway deployment). For local dev this can be http://localhost:8000
# The frontend auto-appends /api if the URL does not already end with /api.
VITE_API_BASE_URL=https://your-backend.up.railway.app

# WebSocket URL for real-time events (ws:// locally, wss:// in production)
VITE_WEBSOCKET_URL=wss://your-backend.up.railway.app/ws
